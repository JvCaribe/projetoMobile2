# Copie este arquivo para ".env" e preencha com os dados do seu computador.
# O arquivo .env NAO vai para o GitHub (esta no .gitignore).

# Porta em que a API vai rodar
PORT=3000

# Chave secreta usada para assinar os tokens JWT (use um texto longo e aleatorio).
# Para gerar uma: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_secreta_bem_grande

# Dados de conexao com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=finanza
